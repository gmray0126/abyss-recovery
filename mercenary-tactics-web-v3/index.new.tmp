<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>흐린 달의 용병단 · Terrain Test</title>
  <link rel="stylesheet" href="./style.css" />
</head>
<body>
  <main class="app">
    <header class="topbar">
      <div>
        <h1>흐린 달의 용병단</h1>
        <p>8×8 TERRAIN BOARD TEST</p>
      </div>
      <button id="regen" type="button">전장 재생성</button>
    </header>

    <section class="board-shell">
      <canvas id="board" width="1280" height="800" aria-label="8×8 기울어진 전술 보드"></canvas>
      <div class="legend" aria-label="지형 범례">
        <span><i class="swatch ground"></i>땅</span>
        <span><i class="swatch forest"></i>풀숲</span>
        <span><i class="swatch rock"></i>바위</span>
        <span><i class="swatch river"></i>강</span>
        <span><i class="swatch bridge"></i>다리</span>
      </div>
    </section>
  </main>
  <script src="./game.js"></script>
</body>
</html>
