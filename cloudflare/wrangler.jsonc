{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dead-drop-realtime",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "durable_objects": {
    "bindings": [
      {
        "name": "RAID_ROOMS",
        "class_name": "RaidRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RaidRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
